type User{
    id: ID!
    username: String!
    name: String!
    repos: [GitRepo!]!
}

type GitRepo{
    id: ID!
    name: String!
    description: String
}

type Query{
    user(username: String!): User
    users: [User!]!
}

type Mutation{
    createRepo(
        name: String!
        description: String
        ownerUsername: String!
    ): GitRepo!
}
